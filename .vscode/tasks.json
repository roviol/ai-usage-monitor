{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure (linux-debug)",
      "type": "shell",
      "command": "cmake --preset linux-debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "CMake: build (linux-debug)",
      "type": "shell",
      "command": "cmake --build --preset linux-debug --parallel",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: configure (linux-debug)",
      "problemMatcher": ["$gcc"]
    }
  ]
}
